# Stash's Oxy client id: the ApplicationCredential publicKey (oxy_dk_...).
EXPO_PUBLIC_OXY_CLIENT_ID=

# Stash's Oxy application id: photos added to an album are linked to it.
EXPO_PUBLIC_STASH_APPLICATION_ID=

# Oxy's API.
EXPO_PUBLIC_OXY_API_URL=https://api.oxy.so

# Stash's backend (packages/backend).
EXPO_PUBLIC_STASH_API_URL=https://api.stash.oxy.so
